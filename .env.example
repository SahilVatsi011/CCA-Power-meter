# Tuya Cloud API Credentials
# Get these from https://iot.tuya.com (see SETUP_GUIDE.md)
TUYA_ACCESS_ID=your_access_id_here
TUYA_ACCESS_SECRET=your_access_secret_here
TUYA_API_ENDPOINT=https://openapi.tuyain.com
# Use tuyain.com for India region. Other options:
# https://openapi.tuyacn.com  (China)
# https://openapi.tuyaus.com  (US)
# https://openapi.tuyaeu.com  (Europe)

# MongoDB Atlas (get from Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=cca_power_meter

# Optional server settings
# HOST=127.0.0.1   # set to 0.0.0.0 to reach the dashboard from the LAN
# PORT=5000
# FLASK_DEBUG=0
# TTL_RAW_DAYS=90    # raw 10s readings retention
# TTL_1MIN_DAYS=400  # 1-minute aggregates retention

# NEVER commit real secrets. This file is ignored by git.